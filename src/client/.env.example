# Public client configuration; do not put server/provider secrets here.
VITE_YESSYFY_API_ORIGIN=https://your-client-service.example
VITE_YESSYFY_MAIN_ORIGIN=https://main.your-domain.example
VITE_YESSYFY_VISION_ORIGIN=https://vision.your-domain.example
VITE_YESSYFY_ENVIRONMENT=production
# Optional provider URL with {z}/{x}/{y}; supply its required attribution.
VITE_YESSYFY_MAP_TILE_URL=
VITE_YESSYFY_MAP_ATTRIBUTION=

# Local GWA server: VITE_YESSYFY_API_ORIGIN=http://127.0.0.1:8080
