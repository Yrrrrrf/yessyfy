  "imports": {
    "@sdk": "./sdk/mod.ts",
    "@sdk/*": "./sdk/*",
    "up-fetch": "npm:up-fetch@2.6.1",
    "vite-plus": "npm:vite-plus@1.1.0",
    "svelte": "npm:svelte@5.57.2",
    "@sveltejs/kit": "npm:@sveltejs/kit@3.0.0-next.32",
    "@sveltejs/adapter-static": "npm:@sveltejs/adapter-static@4.0.0-next.4",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@7.0.0",
    "tailwindcss": "npm:tailwindcss@4.3.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.3.3",
    "@tailwindcss/forms": "npm:@tailwindcss/forms@0.5.11",
    "@tailwindcss/typography": "npm:@tailwindcss/typography@0.5.20",
    "@lucide/svelte": "npm:@lucide/svelte@1.55.0",
    "daisyui": "npm:daisyui@5.7.47",
    "rune-lab": "npm:rune-lab@0.5.2-rc.2",
    "esm-env": "npm:esm-env",
    "arktype": "npm:arktype@2.2.8",
    "xstate": "npm:xstate@5.33.2",
    "leaflet": "npm:leaflet@1.9.4",
    "@types/leaflet": "npm:@types/leaflet@1.9.4"
  },
  "tasks": {
