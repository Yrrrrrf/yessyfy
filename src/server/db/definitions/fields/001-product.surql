DEFINE FIELD data.phone ON user TYPE string;
DEFINE FIELD data.roles ON user TYPE array<'customer' | 'collaborator' | 'operator' | 'admin'>;
DEFINE FIELD data.eligibility ON user TYPE 'unsubmitted' | 'submitted' | 'verified' | 'rejected';
DEFINE FIELD data.currency ON user TYPE 'MXN';
DEFINE FIELD data.duty ON user TYPE bool;
DEFINE FIELD data.locale ON user TYPE 'es' | 'en';
DEFINE FIELD data.status ON job_order TYPE 'pending_triage' | 'dispatched' | 'accepted' | 'in_transit' | 'in_progress' | 'pending_quote_approval' | 'pending_validation' | 'validated' | 'completed' | 'disputed' | 'cancelled';
DEFINE FIELD data.customer_id ON job_order TYPE string;
DEFINE FIELD data.collaborator_id ON job_order TYPE option<string>;
DEFINE FIELD data.revision ON job_order TYPE int;
DEFINE FIELD data.qa ON job_order TYPE 'not_ready' | 'pending' | 'accepted' | 'rejected';
DEFINE FIELD data.customer_review ON job_order TYPE 'pending' | 'accepted' | 'issue';
DEFINE FIELD data.finance.total_cents ON job_order TYPE int ASSERT $value >= 0 AND $value <= 1000000000000;
DEFINE FIELD data.finance.fee_cents ON job_order TYPE int ASSERT $value >= 0 AND $value <= 1000000000000;
DEFINE FIELD data.finance.withholding_cents ON job_order TYPE int ASSERT $value >= 0 AND $value <= 1000000000000;
DEFINE FIELD data.finance.net_cents ON job_order TYPE int ASSERT $value >= 0 AND $value <= 1000000000000;
DEFINE FIELD data.finance.payment ON job_order TYPE 'pending' | 'reserved' | 'confirmed' | 'failed';
DEFINE FIELD data.finance.payout ON job_order TYPE 'not_ready' | 'pending' | 'confirmed' | 'failed';
DEFINE FIELD data.status ON dispatch_offer TYPE 'pending' | 'accepted' | 'declined' | 'expired';
DEFINE FIELD data.collaborator_id ON dispatch_offer TYPE string;
DEFINE FIELD data.expires_at ON dispatch_offer TYPE datetime;
DEFINE FIELD data.size ON media_asset TYPE int;
DEFINE FIELD data.type ON media_asset TYPE 'image/png' | 'image/jpeg' | 'image/webp';
DEFINE FIELD data.state ON media_asset TYPE 'ticket' | 'uploaded' | 'completed' | 'attached';
DEFINE FIELD data.purpose ON media_asset TYPE 'evidence' | 'verification';
DEFINE FIELD data.status ON document_request TYPE 'processing' | 'ready' | 'failed';
DEFINE FIELD data.kind ON document_request TYPE 'report' | 'warranty' | 'invoice';
DEFINE FIELD data.status ON payout TYPE 'pending' | 'confirmed' | 'failed';
DEFINE FIELD data.net_cents ON payout TYPE int ASSERT $value >= 0 AND $value <= 1000000000000;
DEFINE FIELD data.status ON payment_attempt TYPE 'pending' | 'confirmed' | 'failed';
DEFINE FIELD data.amount_cents ON payment_attempt TYPE int ASSERT $value >= 0 AND $value <= 1000000000000;
DEFINE FIELD data.status ON service_case TYPE 'open' | 'reviewing' | 'resolved';
DEFINE FIELD data.status ON business_job TYPE 'queued' | 'running' | 'succeeded' | 'failed';
DEFINE FIELD data.kind ON business_job TYPE 'otp' | 'document' | 'payment' | 'payout';
DEFINE FIELD data.attempts ON business_job TYPE int;
DEFINE FIELD data.next_at ON business_job TYPE datetime;
DEFINE FIELD data.amount_cents ON escrow_entry TYPE int ASSERT $value > 0 AND $value <= 1000000000000;
DEFINE FIELD data.debit ON escrow_entry TYPE string;
DEFINE FIELD data.credit ON escrow_entry TYPE string;
DEFINE FIELD data.cursor ON feed_event TYPE int;
DEFINE FIELD data.kind ON feed_event TYPE 'order' | 'conversation' | 'offer' | 'inbox' | 'gap';
DEFINE FIELD data.operation ON operation_receipt TYPE string;
DEFINE FIELD data.hash ON operation_receipt TYPE string;
DEFINE FIELD data.resource_id ON operation_receipt TYPE string;
